# Copy to .env and fill in. .env is gitignored.

# --- Database (required) ---
DATABASE_URL=mysql://proofpass:change-me@127.0.0.1:3306/proofpass

# --- Session (required) ---
# Sessions are self-contained HS256 JWTs signed with this secret and verified
# locally, so authentication needs no round trip to an OAuth server.
JWT_SECRET=generate-a-long-random-string
VITE_APP_ID=proofpass-local

# This openId is promoted to the admin role on upsert.
OWNER_OPEN_ID=

# --- Hosted sign-in (optional) ---
# Leave both empty and the UI states that sign-in is unavailable instead of
# offering a button that cannot work.
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# --- Proof server ---
# Where the server forwards /proof-server. Run one with
# tools/localnet/standalone.yml; a circuit call needs it, because the hosted
# preprod prover sits behind a proxy refusing bodies over a few kilobytes while
# a call uploads a ~2.7 MB proving key.
PROOF_SERVER_URL=http://127.0.0.1:6300

# Where the BROWSER proves. Unset is right: it uses the same-origin
# /proof-server path, because Lace's service worker refuses a page fetch to
# 127.0.0.1 and a same-origin path also keeps the prover off the internet.
# Set an absolute URL only for a prover somewhere else; set it empty to make the
# wallet prove with its own.
# VITE_PROOF_SERVER_URI=

# --- Serving behind a tunnel (optional) ---
# The dev server refuses a Host it does not know; add tunnel hostnames here.
# Comma separated, leading dot for a wildcard: .example.org,proofpass.example.org
VITE_ALLOWED_HOSTS=

# --- Midnight network (must match the network your wallet is on) ---
MIDNIGHT_NETWORK_ID=preprod
VITE_MIDNIGHT_NETWORK=preprod

# --- Compact artifacts (absolute paths; produced by `pnpm contracts:build`) ---
MIDNIGHT_COMPACT_MODULE_PATH=
MIDNIGHT_COMPACT_ASSETS_PATH=
MIDNIGHT_COMPACT_CONTRACT_TAG=proofpass
